<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.falconx.market.repository.mapper.MarketFeaturedSymbolMapper">

    <resultMap id="MarketFeaturedSymbolRecordMap"
               type="com.falconx.market.repository.mapper.record.MarketFeaturedSymbolRecord">
        <constructor>
            <arg column="platform_symbol" javaType="java.lang.String"/>
            <arg column="sort_order" javaType="java.lang.Integer"/>
            <arg column="enabled" javaType="java.lang.Integer"/>
            <arg column="created_at" javaType="java.time.OffsetDateTime"/>
            <arg column="updated_at" javaType="java.time.OffsetDateTime"/>
        </constructor>
    </resultMap>

    <select id="selectAllOrdered" resultMap="MarketFeaturedSymbolRecordMap">
        SELECT platform_symbol, sort_order, enabled, created_at, updated_at
        FROM t_featured_symbol
        ORDER BY sort_order ASC, platform_symbol ASC
    </select>

    <delete id="deleteAll">
        DELETE FROM t_featured_symbol
    </delete>

    <insert id="batchInsert">
        INSERT INTO t_featured_symbol (platform_symbol, sort_order, enabled)
        VALUES
        <foreach collection="items" item="it" separator=",">
            (#{it.platformSymbol}, #{it.sortOrder}, #{it.enabled})
        </foreach>
    </insert>
</mapper>
