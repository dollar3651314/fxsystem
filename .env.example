# FalconX 本地运行环境变量键名参考模板。
#
# ⚠️ 现状：本私有仓库已**直接提交真实 `.env`（+ tools/*-truststore.p12）**用于多机同步
#   （commit c95ca5a8「提交 .env + wallet-truststore 到私有仓库便于多机同步」）——
#   所以换机从 GitHub clone 后**通常已带可用 `.env`，无需手工配置**。
#   本 `.env.example` 仅作：① 键名/结构参考；② 起新环境或轮换机密时的模板（`cp .env.example .env` 后填值）。
#   （.gitignore 同时配了 `.env` 忽略规则，但 .env 是在该规则前就已被 git 跟踪，规则对已跟踪文件不生效。
#    若将来要改为"机密不入库"，需 `git rm --cached .env*` 并各机自备 .env——这是安全/便利取舍，由用户决定。）
#
# market/wallet 通过 `set -a && source .env` 读取（见 local-start.sh）。
#
# 说明：
#   - 本地开发（--spring.profiles.active=dev）下，各服务的 DB 连接、identity/console/gateway 的
#     RSA JWT 密钥由 application-dev.yml 提供本地默认值，无需在 .env 配置。
#   - 本文件只列「外部第三方密钥」类——LP 行情源凭证 + 链上钱包私钥/助记词——这些是各人/各环境
#     独有的真实机密，仓库不持有，必须自行填入。缺失时 market/wallet 启动会报缺值或外部连接失败，
#     但 identity/gateway/trading-core + 前端不依赖它们，可独立调试。
#   - 含空格的值（如助记词）必须用双引号包裹，否则 bash source 会把空格后的词当命令（见 local-start.sh 注释）。

# ── market-service DB（dev profile 已有默认；仅当不走 dev profile 时需要）──
FALCONX_MARKET_DB_USERNAME=root
FALCONX_MARKET_DB_PASSWORD=root

# ── 服务间内部 RPC token（dev/test 默认 falconx-internal-dev-token；生产用强随机）──
FALCONX_INTERNAL_API_TOKEN=falconx-internal-dev-token

# ── market-service LP 自建行情源凭证（真实机密，向 LP 提供方获取）──
FALCONX_MARKET_LP_URI=
FALCONX_MARKET_LP_DOMAIN=
FALCONX_MARKET_LP_APP_ID=
FALCONX_MARKET_LP_SERVER_ID=
FALCONX_MARKET_LP_META_TRADER_ID=
FALCONX_MARKET_LP_META_TRADE_VERSION=
FALCONX_MARKET_LP_EIO=
FALCONX_MARKET_LP_TOKEN=
FALCONX_MARKET_LP_AUTHORIZATION=
FALCONX_MARKET_LP_SECRET_KEY=

# ── wallet-service 链上凭证（真实机密：私钥/助记词，切勿提交真实值）──
# Ethereum RPC（Alchemy 等）HTTPS endpoint
ALCHEMY_ETHEREUM_NILETEST_HTTPS=
# ERC20（ETH 链）归集地址 + 私钥（PEM）+ 代币合约
FALCONX_WALLET_ERC20_FROM_ADDRESS=
FALCONX_WALLET_ERC20_PRIVATE_KEY_PEM=
FALCONX_WALLET_ERC20_USDT_CONTRACT=
FALCONX_WALLET_ERC20_USDT_DECIMALS=6
FALCONX_WALLET_ERC20_USDC_CONTRACT=
FALCONX_WALLET_ERC20_USDC_DECIMALS=6
# TRC20（TRON 链）归集地址 + 助记词 + 私钥 + 代币合约
FALCONX_WALLET_TRC20_FROM_ADDRESS=
FALCONX_WALLET_TRC20_MNEMONIC_WORDS="word1 word2 ... word12"
FALCONX_WALLET_TRC20_PRIVATE_KEY_PEM=
FALCONX_WALLET_TRC20_USDT_CONTRACT=
FALCONX_WALLET_TRC20_USDT_DECIMALS=6
