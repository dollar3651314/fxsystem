<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.falconx.console.repository.mapper.AdminUserMapper">

    <resultMap id="adminUserRecordMap" type="com.falconx.console.repository.mapper.record.AdminUserRecord">
        <constructor>
            <idArg column="id" javaType="java.lang.Long"/>
            <arg column="username" javaType="java.lang.String"/>
            <arg column="password_hash" javaType="java.lang.String"/>
            <arg column="real_name" javaType="java.lang.String"/>
            <arg column="status" javaType="java.lang.Integer"/>
            <arg column="must_change_password" javaType="java.lang.Integer"/>
            <arg column="last_login_at" javaType="java.time.LocalDateTime"/>
            <arg column="last_login_ip" javaType="java.lang.String"/>
            <arg column="created_at" javaType="java.time.LocalDateTime"/>
            <arg column="updated_at" javaType="java.time.LocalDateTime"/>
        </constructor>
    </resultMap>

    <sql id="baseColumns">
        id, username, password_hash, real_name, status, must_change_password,
        last_login_at, last_login_ip, created_at, updated_at
    </sql>

    <select id="selectByUsername" resultMap="adminUserRecordMap">
        SELECT <include refid="baseColumns"/>
        FROM t_admin_user WHERE username = #{username} LIMIT 1
    </select>

    <select id="selectById" resultMap="adminUserRecordMap">
        SELECT <include refid="baseColumns"/>
        FROM t_admin_user WHERE id = #{id} LIMIT 1
    </select>

    <update id="updateLastLogin">
        UPDATE t_admin_user SET last_login_at = #{lastLoginAt}, last_login_ip = #{lastLoginIp}
        WHERE id = #{id}
    </update>

    <update id="updatePassword">
        UPDATE t_admin_user SET password_hash = #{passwordHash}, must_change_password = 0
        WHERE id = #{id}
    </update>

    <!-- P2 列表查询 -->
    <resultMap id="adminUserListRecordMap" type="com.falconx.console.repository.mapper.record.AdminUserListRecord">
        <constructor>
            <idArg column="id" javaType="java.lang.Long"/>
            <arg column="username" javaType="java.lang.String"/>
            <arg column="real_name" javaType="java.lang.String"/>
            <arg column="status" javaType="java.lang.Integer"/>
            <arg column="must_change_password" javaType="java.lang.Integer"/>
            <arg column="last_login_at" javaType="java.time.LocalDateTime"/>
            <arg column="last_login_ip" javaType="java.lang.String"/>
            <arg column="created_at" javaType="java.time.LocalDateTime"/>
        </constructor>
    </resultMap>

    <sql id="userListWhere">
        <where>
            <if test="username != null and username != ''">
                AND u.username LIKE CONCAT('%', #{username}, '%')
            </if>
            <if test="realName != null and realName != ''">
                AND u.real_name LIKE CONCAT('%', #{realName}, '%')
            </if>
            <if test="status != null">
                AND u.status = #{status}
            </if>
            <if test="roleCode != null and roleCode != ''">
                AND EXISTS (
                    SELECT 1 FROM t_admin_user_role ur2
                    INNER JOIN t_admin_role r2 ON r2.id = ur2.role_id
                    WHERE ur2.user_id = u.id AND r2.code = #{roleCode}
                )
            </if>
            <if test="from != null">
                AND u.created_at &gt;= #{from}
            </if>
            <if test="to != null">
                AND u.created_at &lt; #{to}
            </if>
        </where>
    </sql>

    <select id="selectUsersForList" resultMap="adminUserListRecordMap">
        SELECT u.id, u.username, u.real_name, u.status, u.must_change_password,
               u.last_login_at, u.last_login_ip, u.created_at
        FROM t_admin_user u
        <include refid="userListWhere"/>
        ORDER BY u.created_at DESC, u.id DESC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="countUsers" resultType="java.lang.Long">
        SELECT COUNT(*) FROM t_admin_user u
        <include refid="userListWhere"/>
    </select>

    <resultMap id="adminUserRoleRecordMap" type="com.falconx.console.repository.mapper.record.AdminUserRoleRecord">
        <constructor>
            <idArg column="user_id" javaType="java.lang.Long"/>
            <arg column="role_id" javaType="java.lang.Long"/>
            <arg column="role_code" javaType="java.lang.String"/>
            <arg column="role_name" javaType="java.lang.String"/>
        </constructor>
    </resultMap>

    <select id="selectRolesForUserIds" resultMap="adminUserRoleRecordMap">
        SELECT ur.user_id, r.id AS role_id, r.code AS role_code, r.name AS role_name
        FROM t_admin_user_role ur
        INNER JOIN t_admin_role r ON r.id = ur.role_id
        WHERE ur.user_id IN
        <foreach collection="userIds" item="uid" open="(" separator="," close=")">
            #{uid}
        </foreach>
        ORDER BY ur.user_id, r.id
    </select>

    <insert id="insertUser">
        INSERT INTO t_admin_user (id, username, password_hash, real_name, status, must_change_password)
        VALUES (#{id}, #{username}, #{passwordHash}, #{realName}, #{status}, #{mustChangePassword})
    </insert>

    <update id="updateRealName">
        UPDATE t_admin_user SET real_name = #{realName} WHERE id = #{id}
    </update>

    <update id="updateStatus">
        UPDATE t_admin_user SET status = #{status} WHERE id = #{id}
    </update>

    <delete id="deleteUser">
        DELETE FROM t_admin_user WHERE id = #{id}
    </delete>

    <delete id="deleteUserRoles">
        DELETE FROM t_admin_user_role WHERE user_id = #{userId}
    </delete>

    <insert id="insertUserRoles">
        INSERT INTO t_admin_user_role (user_id, role_id) VALUES
        <foreach collection="roleIds" item="rid" separator=",">
            (#{userId}, #{rid})
        </foreach>
    </insert>

    <update id="resetPassword">
        UPDATE t_admin_user
        SET password_hash = #{passwordHash},
            must_change_password = #{mustChangePassword}
        WHERE id = #{id}
    </update>

</mapper>
