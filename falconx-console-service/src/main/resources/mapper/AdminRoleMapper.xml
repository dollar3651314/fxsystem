<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.falconx.console.repository.mapper.AdminRoleMapper">

    <resultMap id="adminRoleRecordMap" type="com.falconx.console.repository.mapper.record.AdminRoleRecord">
        <constructor>
            <idArg column="id" javaType="java.lang.Long"/>
            <arg column="code" javaType="java.lang.String"/>
            <arg column="name" javaType="java.lang.String"/>
        </constructor>
    </resultMap>

    <select id="selectRolesByUserId" resultMap="adminRoleRecordMap">
        SELECT r.id, r.code, r.name
        FROM t_admin_role r
        INNER JOIN t_admin_user_role ur ON ur.role_id = r.id
        WHERE ur.user_id = #{userId}
        ORDER BY r.id ASC
    </select>

    <!-- P3 列表 / 详情 / CRUD -->
    <resultMap id="adminRoleListRecordMap" type="com.falconx.console.repository.mapper.record.AdminRoleListRecord">
        <constructor>
            <idArg column="id" javaType="java.lang.Long"/>
            <arg column="code" javaType="java.lang.String"/>
            <arg column="name" javaType="java.lang.String"/>
            <arg column="description" javaType="java.lang.String"/>
            <arg column="is_system" javaType="java.lang.Integer"/>
            <arg column="member_count" javaType="java.lang.Long"/>
            <arg column="permission_count" javaType="java.lang.Long"/>
            <arg column="created_at" javaType="java.time.OffsetDateTime"/>
        </constructor>
    </resultMap>

    <resultMap id="adminRoleDetailRecordMap" type="com.falconx.console.repository.mapper.record.AdminRoleDetailRecord">
        <constructor>
            <idArg column="id" javaType="java.lang.Long"/>
            <arg column="code" javaType="java.lang.String"/>
            <arg column="name" javaType="java.lang.String"/>
            <arg column="description" javaType="java.lang.String"/>
            <arg column="is_system" javaType="java.lang.Integer"/>
            <arg column="created_at" javaType="java.time.OffsetDateTime"/>
        </constructor>
    </resultMap>

    <sql id="roleListWhere">
        <where>
            <if test="code != null and code != ''">
                AND r.code = #{code}
            </if>
            <if test="name != null and name != ''">
                AND r.name LIKE CONCAT('%', #{name}, '%')
            </if>
            <if test="isSystem != null">
                AND r.is_system = #{isSystem}
            </if>
        </where>
    </sql>

    <select id="selectRolesForList" resultMap="adminRoleListRecordMap">
        SELECT r.id, r.code, r.name, r.description, r.is_system, r.created_at,
               COALESCE(mc.member_count, 0) AS member_count,
               COALESCE(pc.permission_count, 0) AS permission_count
        FROM t_admin_role r
        LEFT JOIN (
            SELECT role_id, COUNT(*) AS member_count FROM t_admin_user_role GROUP BY role_id
        ) mc ON mc.role_id = r.id
        LEFT JOIN (
            SELECT role_id, COUNT(*) AS permission_count FROM t_admin_role_permission GROUP BY role_id
        ) pc ON pc.role_id = r.id
        <include refid="roleListWhere"/>
        ORDER BY r.id ASC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="countRoles" resultType="java.lang.Long">
        SELECT COUNT(*) FROM t_admin_role r
        <include refid="roleListWhere"/>
    </select>

    <select id="selectRoleById" resultMap="adminRoleDetailRecordMap">
        SELECT id, code, name, description, is_system, created_at
        FROM t_admin_role WHERE id = #{id}
    </select>

    <select id="selectRoleByCode" resultMap="adminRoleDetailRecordMap">
        SELECT id, code, name, description, is_system, created_at
        FROM t_admin_role WHERE code = #{code}
    </select>

    <insert id="insertRole">
        INSERT INTO t_admin_role (id, code, name, description, is_system)
        VALUES (#{id}, #{code}, #{name}, #{description}, 0)
    </insert>

    <update id="updateRole">
        UPDATE t_admin_role
        SET name = #{name},
            description = #{description}
        WHERE id = #{id}
    </update>

    <delete id="deleteRole">
        DELETE FROM t_admin_role WHERE id = #{id}
    </delete>

    <select id="countMembersByRoleId" resultType="java.lang.Long">
        SELECT COUNT(*) FROM t_admin_user_role WHERE role_id = #{roleId}
    </select>

    <select id="selectPermissionCodesByRoleId" resultType="java.lang.String">
        SELECT permission_code FROM t_admin_role_permission
        WHERE role_id = #{roleId}
        ORDER BY permission_code ASC
    </select>

    <delete id="deletePermissionsByRoleId">
        DELETE FROM t_admin_role_permission WHERE role_id = #{roleId}
    </delete>

    <insert id="insertRolePermissions">
        INSERT INTO t_admin_role_permission (role_id, permission_code)
        VALUES
        <foreach collection="permissionCodes" item="code" separator=",">
            (#{roleId}, #{code})
        </foreach>
    </insert>

</mapper>
