<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.falconx.trading.repository.mapper.TradingSymbolCorrelationGroupMapper">

    <resultMap id="groupMap" type="com.falconx.trading.repository.mapper.record.TradingSymbolCorrelationGroupRecord">
        <constructor>
            <idArg column="group_code"    javaType="java.lang.String"/>
            <arg   column="group_name"    javaType="java.lang.String"/>
            <arg   column="threshold_usd" javaType="java.math.BigDecimal"/>
            <arg   column="enabled"       javaType="java.lang.Integer"/>
        </constructor>
    </resultMap>

    <resultMap id="memberMap" type="com.falconx.trading.repository.mapper.record.TradingSymbolCorrelationMemberRecord">
        <constructor>
            <idArg column="group_code" javaType="java.lang.String"/>
            <idArg column="symbol"     javaType="java.lang.String"/>
            <arg   column="weight"     javaType="java.math.BigDecimal"/>
        </constructor>
    </resultMap>

    <select id="selectAllEnabled" resultMap="groupMap">
        SELECT group_code, group_name, threshold_usd, enabled
        FROM t_symbol_correlation_group
        WHERE enabled = 1
        ORDER BY group_code
    </select>

    <select id="selectAllMembers" resultMap="memberMap">
        SELECT m.group_code, m.symbol, m.weight
        FROM t_symbol_correlation_member m
        JOIN t_symbol_correlation_group g ON g.group_code = m.group_code AND g.enabled = 1
        ORDER BY m.group_code, m.symbol
    </select>

    <select id="selectGroupsBySymbol" resultMap="groupMap">
        SELECT g.group_code, g.group_name, g.threshold_usd, g.enabled
        FROM t_symbol_correlation_group g
        JOIN t_symbol_correlation_member m ON m.group_code = g.group_code
        WHERE g.enabled = 1 AND m.symbol = #{symbol}
        ORDER BY g.group_code
    </select>

    <select id="selectMembersByGroupCodes" resultMap="memberMap">
        SELECT group_code, symbol, weight
        FROM t_symbol_correlation_member
        WHERE group_code IN
        <foreach collection="groupCodes" item="code" open="(" separator="," close=")">
            #{code}
        </foreach>
        ORDER BY group_code, symbol
    </select>

</mapper>
