<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.falconx.trading.repository.mapper.TradingNotificationTemplateMapper">

    <resultMap id="recordMap" type="com.falconx.trading.repository.mapper.record.TradingNotificationTemplateRecord">
        <constructor>
            <idArg column="code"           javaType="java.lang.String"/>
            <arg   column="title_template" javaType="java.lang.String"/>
            <arg   column="body_template"  javaType="java.lang.String"/>
            <arg   column="level"          javaType="java.lang.Integer"/>
            <arg   column="channels"       javaType="java.lang.String"/>
            <arg   column="description"    javaType="java.lang.String"/>
            <arg   column="enabled"        javaType="java.lang.Integer"/>
            <arg   column="created_at"     javaType="java.time.LocalDateTime"/>
            <arg   column="updated_at"     javaType="java.time.LocalDateTime"/>
        </constructor>
    </resultMap>

    <sql id="cols">
        code, title_template, body_template, level, channels, description, enabled, created_at, updated_at
    </sql>

    <insert id="insert" parameterType="com.falconx.trading.repository.mapper.record.TradingNotificationTemplateRecord">
        INSERT INTO t_notification_template (<include refid="cols"/>) VALUES (
            #{code}, #{titleTemplate}, #{bodyTemplate}, #{level}, #{channels}, #{description},
            #{enabled}, #{createdAt}, #{updatedAt}
        )
    </insert>

    <select id="selectByCode" resultMap="recordMap">
        SELECT <include refid="cols"/> FROM t_notification_template WHERE code = #{code}
    </select>

    <select id="selectPaginated" resultMap="recordMap">
        SELECT <include refid="cols"/>
        FROM t_notification_template
        WHERE 1 = 1
        <if test="enabled != null">AND enabled = #{enabled}</if>
        <if test="levelCode != null">AND level = #{levelCode}</if>
        ORDER BY created_at DESC, code ASC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="countFiltered" resultType="long">
        SELECT COUNT(1) FROM t_notification_template
        WHERE 1 = 1
        <if test="enabled != null">AND enabled = #{enabled}</if>
        <if test="levelCode != null">AND level = #{levelCode}</if>
    </select>

    <update id="update">
        UPDATE t_notification_template
        SET title_template = #{titleTemplate},
            body_template = #{bodyTemplate},
            level = #{level},
            channels = #{channels},
            description = #{description},
            enabled = #{enabled},
            updated_at = #{updatedAt}
        WHERE code = #{code}
    </update>

    <update id="softDelete">
        UPDATE t_notification_template
        SET enabled = 0, updated_at = #{updatedAt}
        WHERE code = #{code} AND enabled = 1
    </update>

</mapper>
